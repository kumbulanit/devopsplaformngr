  "lab05-iac-terraform": {
    "title": "Lab 05 \u2014 Infrastructure as Code with Terraform",
    "commands": [
      {
        "command": "docker build -t order-service:lab02 --build-arg BUILD_ID=lab02 -f Dockerfile .",
        "directory": "labs/app",
        "classification": "run"
      },
      {
        "command": "docker build -t payment-service:lab02 --build-arg BUILD_ID=lab02 -f Dockerfile.payment .",
        "directory": "labs/app",
        "classification": "run"
      },
      {
        "command": "cp terraform.tfvars.example terraform.tfvars",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform init",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "cat .terraform.lock.hcl",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform plan -out=tfplan",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform apply tfplan",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform output order_service_url",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "curl $(terraform output -raw order_service_url)/health",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "curl -X POST $(terraform output -raw order_service_url)/orders \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"item\":\"cappuccino\",\"quantity\":1,\"price\":4.5}'",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform state list",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform state show docker_container.order_service",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform plan",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform apply",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "curl http://localhost:8092/health",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "terraform destroy",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      },
      {
        "command": "docker ps -a --filter \"name=tf-\"",
        "directory": "labs/lab05-iac-terraform",
        "classification": "run"
      }
    ]
  },
