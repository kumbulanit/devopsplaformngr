  "lab01-git-collaboration": {
    "title": "Lab 01 \u2014 Culture and Collaboration with Git",
    "commands": [
      {
        "command": "mkdir -p /tmp/lab01 && cp -r labs/app /tmp/lab01/app",
        "directory": ".",
        "classification": "run"
      },
      {
        "command": "rm -rf .venv .pytest_cache __pycache__",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git init -b main",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git add .",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git commit -m \"Initial order and payment services\"",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "source \"$COURSE_HOME\"/labs/app/.venv/bin/activate",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "pytest",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git checkout -b feature/health-service-name",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "pytest",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git add main.py",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git commit -m \"feat: add service_name to health endpoint\"",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git clone --bare /tmp/lab01/app /tmp/lab01/review-repo.git",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git remote add local /tmp/lab01/review-repo.git",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git push local feature/health-service-name",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git clone review-repo.git reviewer-copy",
        "directory": "/tmp/lab01",
        "classification": "run"
      },
      {
        "command": "git checkout feature/health-service-name",
        "directory": "reviewer-copy",
        "classification": "run"
      },
      {
        "command": "git diff main..feature/health-service-name",
        "directory": "reviewer-copy",
        "classification": "run"
      },
      {
        "command": "git checkout main",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git merge --no-ff feature/health-service-name -m \"Merge feature/health-service-name\"",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git push local main",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "git log --oneline --graph --all",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "pytest",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "cat > .git/hooks/commit-msg <<'EOF'\nif grep -qE 'TODO|FIXME' \"$1\" && ! grep -qE '#[0-9]+' \"$1\"; then\n  echo \"Commit message with TODO/FIXME must include a ticket ID (e.g. #123)\"\n  exit 1\nfi\nEOF",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "chmod +x .git/hooks/commit-msg",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      },
      {
        "command": "rm -rf /tmp/lab01",
        "directory": "/tmp/lab01/app",
        "classification": "run"
      }
    ]
  },
