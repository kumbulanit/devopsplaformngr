  "lab07-devsecops": {
    "title": "Lab 07 \u2014 DevSecOps Scanning & Policy as Code",
    "commands": [
      {
        "command": "brew install aquasecurity/trivy/trivy",
        "directory": ".",
        "classification": "skip-os-specific"
      },
      {
        "command": "winget install Aquasecurity.Trivy",
        "directory": ".",
        "classification": "skip-os-specific"
      },
      {
        "command": "curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin",
        "directory": ".",
        "classification": "run"
      },
      {
        "command": "trivy version",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy image --severity HIGH,CRITICAL order-service:lab02",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy fs --scanners secret .",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy config labs/lab05-iac-terraform",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy config labs/lab06-kubernetes-kind",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "brew install conftest   # macOS",
        "directory": ".",
        "classification": "skip-os-specific"
      },
      {
        "command": "mkdir -p labs/lab07-devsecops/policy",
        "directory": ".",
        "classification": "run"
      },
      {
        "command": "cat > labs/lab07-devsecops/policy/labels.rego <<'EOF'\npackage main\ndeny[msg] {\n  input.kind == \"Deployment\"\n  not input.metadata.labels.course\n  msg := \"Deployment must have a 'course' label\"\n}\nEOF",
        "directory": ".",
        "classification": "run"
      },
      {
        "command": "conftest test labs/lab06-kubernetes-kind/*.yaml --policy labs/lab07-devsecops/policy",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "git add labs/lab07-devsecops/policy",
        "directory": ".",
        "classification": "run"
      },
      {
        "command": "git commit -m \"Add Kubernetes label policy\"",
        "directory": ".",
        "classification": "run"
      }
    ]
  },
