  "lab07-devsecops": {
    "title": "Lab 07 \u2014 DevSecOps: Scanning & Policy as Code",
    "commands": [
      {
        "command": "trivy image --severity HIGH,CRITICAL order-service:lab02",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy image --severity CRITICAL --ignore-unfixed order-service:lab02",
        "directory": ".",
        "classification": "conditional-tool"
      },
      {
        "command": "trivy fs --scanners secret .",
        "directory": "\"$COURSE_HOME\"",
        "classification": "conditional-tool"
